<?xml version="1.0"?>
<robot name="supermarketbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Physical Properties (Đã cập nhật theo đo thực tế) -->
  <xacro:property name="robot_length" value="0.280"/> <!-- 28 cm dài -->
  <xacro:property name="robot_width"  value="0.150"/> <!-- 15 cm ngang -->
  <xacro:property name="robot_height" value="0.120"/> <!-- 12 cm chassis -->
  <xacro:property name="wheel_radius" value="0.0325"/> <!-- 6.5 cm đường kính bánh -->
  <xacro:property name="wheel_width"  value="0.025"/>
  <xacro:property name="lidar_z_offset" value="0.400"/> <!-- 40 cm từ đất lên mắt quét LiDAR -->

  <!-- Base Footprint (thương hiệu điểm trên mặt đất) -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Base Link (Tâm khung robot) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${robot_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${robot_length} ${robot_width} ${robot_height}"/>
      </geometry>
      <material name="chassis_color">
        <color rgba="0.15 0.20 0.25 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${robot_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${robot_length} ${robot_width} ${robot_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- YDLIDAR X3 Link (Gắn đỉnh robot, cao 40cm từ mặt đất) -->
  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.040"/>
      </geometry>
      <material name="lidar_color">
        <color rgba="0.9 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 ${lidar_z_offset - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- IMU Link -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="imu_color">
        <color rgba="0.1 0.8 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Wheels (4 bánh xe 4WD) -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_color">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x_reflect * robot_length/3} ${y_reflect * robot_width/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="fl" x_reflect="1" y_reflect="1"/>
  <xacro:wheel prefix="fr" x_reflect="1" y_reflect="-1"/>
  <xacro:wheel prefix="rl" x_reflect="-1" y_reflect="1"/>
  <xacro:wheel prefix="rr" x_reflect="-1" y_reflect="-1"/>

</robot>
